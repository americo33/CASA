<%- include('partials/header') %>

<div class="page-header">
  <div class="container">
    <h1><i class="fas fa-calendar"></i> Mis Sesiones de Coaching</h1>
    <p>Gestiona tus sesiones con el método GROW</p>
  </div>
</div>

<div class="container section">
  <div class="page-actions">
    <a href="/sessions/new" class="btn btn-primary"><i class="fas fa-plus"></i> Nueva Sesión</a>
  </div>

  <% if (sesiones.length > 0) { %>
    <div class="sessions-list">
      <% sesiones.forEach(s => { %>
        <div class="card session-card">
          <div class="session-card-header">
            <div class="session-card-date">
              <i class="fas fa-calendar"></i>
              <span><%= new Date(s.fecha).toLocaleDateString('es', {weekday:'long', day:'numeric', month:'long', year:'numeric'}) %></span>
              <span class="session-time"><%= new Date(s.fecha).toLocaleTimeString('es', {hour:'2-digit', minute:'2-digit'}) %></span>
            </div>
            <span class="status-badge status-<%= s.estado %>"><%= s.estado %></span>
          </div>
          <div class="session-card-body">
            <h3><%= s.titulo %></h3>
            <p class="session-meta">
              <span><i class="fas fa-bullseye"></i> <%= s.meta_titulo %></span>
              <% if (s.categoria) { %><span class="goal-category"><%= s.categoria %></span><% } %>
            </p>
            <p>
              <% if (user.rol === 'coach' || user.rol === 'admin') { %>
                <i class="fas fa-user"></i> Coachee: <%= s.coachee_nombre %> <%= s.coachee_apellido %>
              <% } else { %>
                <i class="fas fa-user-tie"></i> Coach: <%= s.coach_nombre %> <%= s.coach_apellido %>
              <% } %>
              &middot; <i class="fas fa-clock"></i> <%= s.duracion %> min
            </p>
            <% if (s.grow_goal || s.grow_reality || s.grow_options || s.grow_will) { %>
              <div class="grow-indicators">
                <span class="grow-indicator <%= s.grow_goal ? 'filled' : '' %>">G</span>
                <span class="grow-indicator <%= s.grow_reality ? 'filled' : '' %>">R</span>
                <span class="grow-indicator <%= s.grow_options ? 'filled' : '' %>">O</span>
                <span class="grow-indicator <%= s.grow_will ? 'filled' : '' %>">W</span>
              </div>
            <% } %>
          </div>
          <div class="session-card-footer">
            <a href="/sessions/<%= s.id %>" class="btn btn-primary btn-sm">Ver Sesión GROW</a>
          </div>
        </div>
      <% }) %>
    </div>
  <% } else { %>
    <div class="card text-center p-2">
      <i class="fas fa-calendar-plus" style="font-size:3rem;color:var(--indigo-300)"></i>
      <h3>No tienes sesiones aún</h3>
      <p>Agenda tu primera sesión de coaching con el método GROW</p>
      <a href="/sessions/new" class="btn btn-primary">Agendar Sesión</a>
    </div>
  <% } %>
</div>

<%- include('partials/footer') %>
