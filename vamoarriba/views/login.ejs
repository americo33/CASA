<%- include('partials/header') %>

<div class="auth-page">
  <div class="auth-card">
    <div class="auth-header">
      <i class="fas fa-rocket auth-logo"></i>
      <h2>Bienvenido de vuelta</h2>
      <p>Ingresa a tu cuenta de VamoArriba</p>
    </div>

    <% if (error) { %>
      <div class="alert alert-error"><i class="fas fa-exclamation-circle"></i> <%= error %></div>
    <% } %>

    <form method="POST" action="/login" class="auth-form">
      <div class="form-group">
        <label><i class="fas fa-envelope"></i> Email</label>
        <input type="text" name="email" placeholder="tu@email.com" required autofocus>
      </div>
      <div class="form-group">
        <label><i class="fas fa-lock"></i> Contraseña</label>
        <input type="password" name="password" placeholder="Tu contraseña" required>
      </div>
      <button type="submit" class="btn btn-primary btn-lg btn-block">Iniciar Sesión</button>
    </form>

    <div class="auth-footer">
      <p>¿No tienes cuenta? <a href="/register">Regístrate aquí</a></p>
    </div>

    <div class="auth-demo">
      <p><strong>Cuentas de demostración:</strong></p>
      <small>Admin: admin / admin1234</small><br>
      <small>Coach: maria@vamoarriba.com / coach123</small><br>
      <small>Coachee: pedro@gmail.com / user123</small>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
