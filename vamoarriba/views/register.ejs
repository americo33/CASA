<%- include('partials/header') %>

<div class="auth-page">
  <div class="auth-card auth-card-wide">
    <div class="auth-header">
      <i class="fas fa-rocket auth-logo"></i>
      <h2>Únete a VamoArriba</h2>
      <p>Crea tu cuenta y comienza tu viaje de coaching</p>
    </div>

    <% if (error) { %>
      <div class="alert alert-error"><i class="fas fa-exclamation-circle"></i> <%= error %></div>
    <% } %>

    <form method="POST" action="/register" class="auth-form">
      <div class="form-row">
        <div class="form-group">
          <label>Nombre</label>
          <input type="text" name="nombre" value="<%= form.nombre || '' %>" placeholder="Tu nombre" required>
        </div>
        <div class="form-group">
          <label>Apellido</label>
          <input type="text" name="apellido" value="<%= form.apellido || '' %>" placeholder="Tu apellido" required>
        </div>
      </div>

      <div class="form-group">
        <label>Email</label>
        <input type="email" name="email" value="<%= form.email || '' %>" placeholder="tu@email.com" required>
      </div>

      <div class="form-row">
        <div class="form-group">
          <label>Contraseña</label>
          <input type="password" name="password" placeholder="Mínimo 6 caracteres" required>
        </div>
        <div class="form-group">
          <label>Confirmar Contraseña</label>
          <input type="password" name="password2" placeholder="Repite tu contraseña" required>
        </div>
      </div>

      <div class="form-group">
        <label>¿Cómo quieres registrarte?</label>
        <div class="role-selector">
          <label class="role-option">
            <input type="radio" name="rol" value="coachee" checked>
            <div class="role-card">
              <i class="fas fa-user"></i>
              <strong>Coachee</strong>
              <span>Quiero recibir coaching</span>
            </div>
          </label>
          <label class="role-option">
            <input type="radio" name="rol" value="coach">
            <div class="role-card">
              <i class="fas fa-user-tie"></i>
              <strong>Coach</strong>
              <span>Soy coach profesional</span>
            </div>
          </label>
        </div>
      </div>

      <div class="form-row">
        <div class="form-group">
          <label>País</label>
          <input type="text" name="pais" value="<%= form.pais || '' %>" placeholder="Tu país">
        </div>
        <div class="form-group">
          <label>Ciudad</label>
          <input type="text" name="ciudad" value="<%= form.ciudad || '' %>" placeholder="Tu ciudad">
        </div>
      </div>

      <div class="form-group">
        <label>Especialidad <small>(solo coaches)</small></label>
        <input type="text" name="especialidad" value="<%= form.especialidad || '' %>" placeholder="Ej: Coaching Ejecutivo, Coaching de Vida">
      </div>

      <div class="form-group">
        <label>Sobre ti</label>
        <textarea name="bio" rows="3" placeholder="Cuéntanos un poco sobre ti y tus objetivos..."><%= form.bio || '' %></textarea>
      </div>

      <button type="submit" class="btn btn-primary btn-lg btn-block">Crear Mi Cuenta <i class="fas fa-arrow-right"></i></button>
    </form>

    <div class="auth-footer">
      <p>¿Ya tienes cuenta? <a href="/login">Inicia sesión aquí</a></p>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
