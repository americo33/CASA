<%- include('partials/header') %>

<div class="page-header">
  <div class="container">
    <a href="/sessions" class="back-link"><i class="fas fa-arrow-left"></i> Volver</a>
    <h1><i class="fas fa-calendar-plus"></i> Nueva Sesión de Coaching</h1>
  </div>
</div>

<div class="container section">
  <div class="form-container">
    <div class="card">
      <% if (error) { %>
        <div class="alert alert-error"><%= error %></div>
      <% } %>

      <form method="POST" action="/sessions/new" class="auth-form">
        <div class="form-group">
          <label>Meta Asociada</label>
          <select name="meta_id" required>
            <option value="">Selecciona una meta...</option>
            <% metas.forEach(m => { %>
              <option value="<%= m.id %>"><%= m.titulo %></option>
            <% }) %>
          </select>
        </div>

        <div class="form-group">
          <label>Título de la Sesión</label>
          <input type="text" name="titulo" placeholder="Ej: Sesión de descubrimiento - Liderazgo" required>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label>Fecha y Hora</label>
            <input type="datetime-local" name="fecha" required>
          </div>
          <div class="form-group">
            <label>Duración (minutos)</label>
            <input type="number" name="duracion" value="60" min="30" max="180">
          </div>
        </div>

        <button type="submit" class="btn btn-primary btn-lg">Agendar Sesión <i class="fas fa-calendar-check"></i></button>
      </form>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
