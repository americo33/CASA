<%- include('partials/header') %>

<div class="page-header">
  <div class="container">
    <a href="/profile" class="back-link"><i class="fas fa-arrow-left"></i> Volver</a>
    <h1><i class="fas fa-cog"></i> Editar Perfil</h1>
  </div>
</div>

<div class="container section">
  <div class="form-container">
    <div class="card">
      <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
      <% if (success) { %><div class="alert alert-success"><i class="fas fa-check-circle"></i> <%= success %></div><% } %>

      <form method="POST" action="/profile/edit/me" class="auth-form">
        <div class="form-row">
          <div class="form-group">
            <label>Nombre</label>
            <input type="text" name="nombre" value="<%= profile.nombre %>" required>
          </div>
          <div class="form-group">
            <label>Apellido</label>
            <input type="text" name="apellido" value="<%= profile.apellido %>" required>
          </div>
        </div>
        <div class="form-group">
          <label>Bio</label>
          <textarea name="bio" rows="4"><%= profile.bio || '' %></textarea>
        </div>
        <% if (profile.rol === 'coach') { %>
        <div class="form-group">
          <label>Especialidad</label>
          <input type="text" name="especialidad" value="<%= profile.especialidad || '' %>">
        </div>
        <% } else { %>
          <input type="hidden" name="especialidad" value="<%= profile.especialidad || '' %>">
        <% } %>
        <div class="form-row">
          <div class="form-group">
            <label>Teléfono</label>
            <input type="text" name="telefono" value="<%= profile.telefono || '' %>">
          </div>
          <div class="form-group">
            <label>País</label>
            <input type="text" name="pais" value="<%= profile.pais || '' %>">
          </div>
        </div>
        <div class="form-row">
          <div class="form-group">
            <label>Ciudad</label>
            <input type="text" name="ciudad" value="<%= profile.ciudad || '' %>">
          </div>
          <div class="form-group">
            <label>LinkedIn</label>
            <input type="text" name="linkedin" value="<%= profile.linkedin || '' %>" placeholder="linkedin.com/in/...">
          </div>
        </div>
        <div class="form-group">
          <label>Sitio Web</label>
          <input type="text" name="sitio_web" value="<%= profile.sitio_web || '' %>" placeholder="https://...">
        </div>
        <button type="submit" class="btn btn-primary btn-lg">Guardar Cambios</button>
      </form>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
