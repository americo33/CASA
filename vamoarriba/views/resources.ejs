<%- include('partials/header') %>

<div class="page-header">
  <div class="container">
    <h1><i class="fas fa-book"></i> Recursos de Coaching</h1>
    <p>Artículos, guías y herramientas para tu crecimiento</p>
  </div>
</div>

<div class="container section">
  <div class="grid-3">
    <% recursos.forEach(r => { %>
      <div class="card resource-card-detail">
        <div class="resource-type"><i class="fas fa-<%= r.tipo === 'articulo' ? 'newspaper' : r.tipo === 'video' ? 'video' : 'file-alt' %>"></i> <%= r.tipo %></div>
        <h3><%= r.titulo %></h3>
        <p><%= r.descripcion %></p>
        <% if (r.contenido) { %>
          <div class="resource-content">
            <p><%= r.contenido.substring(0, 200) %>...</p>
          </div>
        <% } %>
        <div class="resource-meta">
          <span><i class="fas fa-user"></i> <%= r.autor_nombre %> <%= r.autor_apellido %></span>
          <span><i class="fas fa-tag"></i> <%= r.categoria %></span>
        </div>
      </div>
    <% }) %>
  </div>

  <% if (recursos.length === 0) { %>
    <div class="card text-center p-2">
      <i class="fas fa-book-open" style="font-size:3rem;color:var(--indigo-300)"></i>
      <h3>No hay recursos disponibles aún</h3>
    </div>
  <% } %>
</div>

<%- include('partials/footer') %>
